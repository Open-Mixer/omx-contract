include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk

%:
	dh $@

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr INCLUDEDIR=/usr/include DATADIR=/usr/share CLIDIR=/usr/lib/omx-contract
	# the C loader (libomx-domain0, libomx-domain-dev): arch-dependent, in the multiarch library directory
	$(MAKE) install-c DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr INCLUDEDIR=/usr/include DATADIR=/usr/share LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) BINDIR=/usr/bin CONTRACTDIR=/usr/share/omx-contract/contract.d CFLAGS='$(CFLAGS) $(CPPFLAGS)' LDFLAGS='$(LDFLAGS)'
	# the Python readers' package omx_contract (python3-omx-contract)
	$(MAKE) install-python DESTDIR=$(CURDIR)/debian/tmp PYTHONDIR=/usr/lib/python3/dist-packages
	$(MAKE) install-cli DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr DATADIR=/usr/share BINDIR=/usr/bin CLIDIR=/usr/lib/omx-contract MANDIR=/usr/share/man

# libomx-domain0.symbols carries the floor of each export; -c4 fails the build on a symbol it does not list
override_dh_makeshlibs:
	dh_makeshlibs -- -c4

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) check
	$(MAKE) check-abi CONTRACTDIR=/usr/share/omx-contract/contract.d CFLAGS='$(CFLAGS) $(CPPFLAGS)' LDFLAGS='$(LDFLAGS)'
endif
