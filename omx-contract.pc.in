prefix=@PREFIX@
includedir=@INCLUDEDIR@
datadir=@DATADIR@/omx-contract
# the kernel recipe (recipes/kernel.recipe.json) a consumer's contract tools read, omx-contract#227
recipesdir=${datadir}/recipes
# the contract directory (docs/contract-dir.md): <contractdir>/<package>/ beside <contractdir>/<domain>/, no major level
contractdir=@CONTRACTDIR@
# the omx-contract command's own files (`make install-cli`): <clidir>/lib/entry.mjs exports isMain for the command-line
# entry points of packages that have no npm dependency on omx-contract. Those files ship in the omx-contract package, not
# in the -devel (-dev) package that holds this file: a consumer importing entry.mjs build-depends on omx-contract itself
clidir=@CLIDIR@

Name: omx-contract
Description: The Open-Mixer declarations as data, rendered as C headers (omxcontract/)
Version: @VERSION@
Cflags: -I${includedir}
