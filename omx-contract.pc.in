prefix=@PREFIX@
includedir=@INCLUDEDIR@
datadir=@DATADIR@/omx-contract
# the contract directory (docs/contract-dir.md): <contractdir>/<schema major>/<package>/
contractdir=@CONTRACTDIR@
# the schema major the contract directory is read under: <contractdir>/<schema_major>/<package>/
schema_major=@SCHEMA_MAJOR@
# the omx-contract command's own files (`make install-cli`): <clidir>/lib/entry.mjs exports isMain for the command-line
# entry points of packages that have no npm dependency on omx-contract
clidir=@CLIDIR@

Name: omx-contract
Description: The Open-Mixer declarations as data, rendered as C headers (omxcontract/)
Version: @VERSION@
Cflags: -I${includedir}
