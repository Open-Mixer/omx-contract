{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/schema/omx-contract/v0/omx-vocabulary.schema.json",
  "title": "omx-contract vocabulary",
  "description": "GENERATED by `omx-contract render --target json` from data/: one enum per codes and words item of the vocabulary (docs/data-layout.md), for a schema that references the words instead of repeating them. GPL-3.0-or-later.",
  "$defs": {
    "RESOURCE_KINDS": {
      "description": "Every resource a host plans a plugin for (FreeMixer/plugin-qualify#116): each measured per machine class, judged per host profile, and unknown, never a pass, when it has no figure.",
      "enum": [
        "cpu",
        "memory",
        "scratch-memory",
        "latency",
        "tail",
        "voices",
        "startup",
        "threads",
        "worker",
        "block-length",
        "open-files",
        "disk-io",
        "network",
        "state"
      ],
      "x-omx-texts": {
        "cpu": {
          "text": {
            "en": "The cost per sample at a rate and quantum, its percentile and its tail."
          },
          "args": []
        },
        "memory": {
          "text": {
            "en": "The footprint per instance and its growth over a soak."
          },
          "args": []
        },
        "scratch-memory": {
          "text": {
            "en": "The memory a plugin asks of its host for its process call."
          },
          "args": []
        },
        "latency": {
          "text": {
            "en": "The frames a plugin delays its output by, per rate and quantum."
          },
          "args": []
        },
        "tail": {
          "text": {
            "en": "How long a plugin keeps sounding once its input goes silent."
          },
          "args": []
        },
        "voices": {
          "text": {
            "en": "The notes an instrument plays at once."
          },
          "args": []
        },
        "startup": {
          "text": {
            "en": "The wall time of instantiate, activate and the first block."
          },
          "args": []
        },
        "threads": {
          "text": {
            "en": "The threads a plugin starts and their scheduling class, or the host thread pool it asks for."
          },
          "args": []
        },
        "worker": {
          "text": {
            "en": "The work a plugin hands to a non-real-time thread of the host."
          },
          "args": []
        },
        "block-length": {
          "text": {
            "en": "The block lengths a plugin accepts."
          },
          "args": []
        },
        "open-files": {
          "text": {
            "en": "The file descriptors a plugin holds after activate, and their growth."
          },
          "args": []
        },
        "disk-io": {
          "text": {
            "en": "The bytes a plugin reads at load and while it processes."
          },
          "args": []
        },
        "network": {
          "text": {
            "en": "Any socket a plugin opens."
          },
          "args": []
        },
        "state": {
          "text": {
            "en": "The size of a plugin's saved state, its save and restore time, and its round trip."
          },
          "args": []
        }
      }
    },
    "RESOURCE_UNITS": {
      "description": "The units a resource figure is given in; an LV2 unit's name where LV2 has one.",
      "enum": [
        "nsPerSample",
        "frames",
        "ms",
        "us",
        "s",
        "bytes",
        "count",
        "ratio",
        "flag"
      ],
      "x-omx-texts": {
        "nsPerSample": {
          "text": {
            "en": "Nanoseconds per sample."
          },
          "args": []
        },
        "frames": {
          "text": {
            "en": "A count of audio frames."
          },
          "args": []
        },
        "ms": {
          "text": {
            "en": "Milliseconds."
          },
          "args": []
        },
        "us": {
          "text": {
            "en": "Microseconds."
          },
          "args": []
        },
        "s": {
          "text": {
            "en": "Seconds."
          },
          "args": []
        },
        "bytes": {
          "text": {
            "en": "Bytes."
          },
          "args": []
        },
        "count": {
          "text": {
            "en": "A plain count, with no unit."
          },
          "args": []
        },
        "ratio": {
          "text": {
            "en": "A ratio, with no unit."
          },
          "args": []
        },
        "flag": {
          "text": {
            "en": "A yes or a no: one when the plugin does the thing, zero when it does not."
          },
          "args": []
        }
      }
    },
    "RESOURCE_BASES": {
      "description": "How a resource figure was known: what the plugin declares, what a run measured, or a count the caller gave the probe.",
      "enum": [
        "declared",
        "measured",
        "probe"
      ],
      "x-omx-texts": {
        "declared": {
          "text": {
            "en": "What the plugin declares about itself."
          },
          "args": []
        },
        "measured": {
          "text": {
            "en": "What a run measured."
          },
          "args": []
        },
        "probe": {
          "text": {
            "en": "A count the caller gave the probe."
          },
          "args": []
        }
      }
    },
    "RESOURCE_HINTS": {
      "description": "What a plugin declares about its own footprint, in openmixer's own hints (FreeMixer/plugin-qualify#116): each a claim plugin-qualify measures and checks, carried by the extension below, as the CLAP draft and as LV2 properties. A hint a plugin does not state is unknown, never zero.",
      "enum": [
        "footprint-at-rest",
        "footprint-per-voice",
        "shared-load",
        "threads-spawned",
        "streams-from-disk",
        "opens-sockets",
        "activate-time"
      ],
      "x-omx-texts": {
        "footprint-at-rest": {
          "text": {
            "en": "The memory one instance holds at rest, once activated and idle, with no note playing."
          },
          "args": []
        },
        "footprint-per-voice": {
          "text": {
            "en": "The memory each voice adds while it plays, for an instrument."
          },
          "args": []
        },
        "shared-load": {
          "text": {
            "en": "The one-time load every instance of the plugin shares, counted once however many are instantiated."
          },
          "args": []
        },
        "threads-spawned": {
          "text": {
            "en": "The threads the plugin starts itself, apart from any it asks the host pool for."
          },
          "args": []
        },
        "streams-from-disk": {
          "text": {
            "en": "Whether the plugin reads from disk while it processes."
          },
          "args": []
        },
        "opens-sockets": {
          "text": {
            "en": "Whether the plugin opens any socket."
          },
          "args": []
        },
        "activate-time": {
          "text": {
            "en": "The wall time of activate and the first block the plugin expects."
          },
          "args": []
        }
      }
    },
    "PARAM_UNITS": {
      "description": "The one list of standard units (the owner's ruling of 2026-11-20, standard vocabulary in one place; docs/units.md): each word's `x-symbol` is its symbol as written (`%`, `\"\"`, `dB/oct`), the word a name the wire can carry, its `x-dimension` what it measures (a word of PARAM_UNIT_DIMENSIONS) and its group its scope (a word of PARAM_UNIT_SCOPES). The schema's $defs.unit enum is the ids (consts) of the `param` units and $defs.descriptorUnit those of the `descriptor` units and `unknown`, in this order (tools/unit-enum.mjs): the id is the wire word, the `x-symbol` its display rendering only (C2, plugin-hostd#215 D1/D2). A word's code is its position in the list, not a wire number (the wire codes are omx-clap's, the unit codes of org.openmixer.param-contract/1): a reader takes the words, so a unit removed shifts the codes after it (omx-contract#167: `x` went, `coef` is the plain multiplier). A level's own spellings (an LV2 unit, a CLAP unit code) map onto these ids at that level.",
