              {
                "ref": "DEMO_HOST_REPLY_CODES.busy"
              }
            ],
            "x-implemented-by": {
              "plugin-hostd": "required"
            },
            "x-since": "1.2.0",
            "description": "Ping the host."
          }
        ]
      }
    }
