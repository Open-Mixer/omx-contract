{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/contract/demo",
  "x-omx-contract": "0.23",
  "info": {
    "title": "The conformance vocabulary",
    "version": "1.2.0",
    "x-owner": "omx-fixture",
    "x-stability": "experimental"
  },
  "components": {
    "schemas": {
      "DEMO_REPLY_CODES": {
        "description": "The refusals.",
        "x-kind": "codes",
        "oneOf": [
          {
            "const": "reply.demo.busy",
            "title": "busy",
            "x-code": 0,
            "x-name": "busy",
            "x-resp": -901,
            "x-transient": true,
            "description": "busy",
            "x-text": "The host is busy; try again.",
            "x-args": []
          }
        ]
      },
      "DEMO_VERBS": {
        "description": "The verbs.",
        "x-kind": "verbs",
        "oneOf": [
          {
            "const": "demo_ping",
            "title": "demoPing",
            "x-code": 0,
            "x-format": "demo_ping %i",
            "x-reply": "resp 0",
            "x-codes": [
              {
                "ref": "DEMO_REPLY_CODES.busy"
              }
            ],
            "x-implemented-by": {
              "plugin-hostd": "required"
            },
            "x-since": "1.2.0",
            "description": "Ping the host."
          }
        ]
      }
    }
  }
}
