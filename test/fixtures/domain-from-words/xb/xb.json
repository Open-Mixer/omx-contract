{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/contract/xb",
  "info": {
    "title": "The paints whose words are taken from the colours of xa",
    "version": "1.0.0",
    "x-owner": "pkg-b",
    "x-stability": "experimental",
    "x-requires": [
      "xa"
    ]
  },
  "components": {
    "schemas": {
      "XB_PAINTS": {
        "description": "The paints of domain xb, each the colour of xa it is taken from.",
        "x-since": "1.0.0",
        "x-c-codes": true,
        "x-kind": "words",
        "x-file": "paints.json",
        "oneOf": [
          {
            "const": "red",
            "title": "red",
            "description": "The warm one.",
            "x-code": 0,
            "x-text": "Red",
            "x-from": [
              {
                "$ref": "https://openmixer.org/contract/xa#/components/schemas/XA_COLORS",
                "x-term": "red"
              }
            ]
          },
          {
            "const": "deep-blue",
            "title": "deepBlue",
            "description": "The cold one.",
            "x-code": 1,
            "x-text": "Blue",
            "x-from": [
              {
                "$ref": "https://openmixer.org/contract/xa#/components/schemas/XA_COLORS",
                "x-term": "deepBlue"
              }
            ]
          }
        ]
      }
    }
  }
}
