{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "declaration": true,
    "rootDir": "src/lib",
    "outDir": "lib",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "newLine": "lf",
    "rootDirs": [
      "src",
      "."
    ]
  },
  "include": [
    "src/lib/*.mts"
  ]
}
